# Appended to the pinned Mesa src/nouveau/vulkan/meson.build by the baseline CI.
# @METALVK_ROOT@ is replaced with the checkout path so the adapter can include
# the metalvk shared standard and compile the one transport.c kept in the repo.
# The metalvk include dirs are passed as -I flags because meson forbids absolute
# include_directories(). No upstream file is replaced; this is an offline
# standard-conformance client for the metalvk side of the transport.
executable(
  'metalvk-nvkmd-adapter',
  ['metalvk-nvkmd-adapter.c', 'metalvk-transport.c'],
  include_directories: [inc_include, inc_src],
  dependencies: nvk_deps + [idep_vtn],
  link_with: libnvk,
  c_args: [
    '-I@METALVK_ROOT@/include',
    '-I@METALVK_ROOT@/backends/nvidia/include',
    '-Werror',
  ],
)
