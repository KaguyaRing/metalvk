# Appended to the pinned Mesa Vulkan meson.build by the baseline CI.
# No upstream implementation is replaced; this is an offline acceptance client.
executable(
  'metalvk-nak-pattern',
  'metalvk-nak-pattern.c',
  include_directories: [inc_include, inc_src],
  dependencies: nvk_deps + [idep_vtn],
  link_with: libnvk,
  c_args: ['-Werror'],
)
