#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { uint values[]; } inputData;
layout(set = 0, binding = 1, std430) writeonly buffer Output { uint values[]; } outputData;
layout(push_constant) uniform Parameters { uint count; uint salt; } parameters;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < parameters.count)
        outputData.values[i] = inputData.values[i] ^ ((i * 1664525u + parameters.salt) ^ 0xa5a55a5au);
}
